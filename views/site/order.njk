{# Ordering, delivery and payment terms  →  Yii2: views/site/order.php (old URL /order.html is kept) #}
{% extends "layouts/main.njk" %}
{% set metaTitle = 'Поръчка и доставка' %}
{% set metaDescription = 'Как да поръчате, доставка с Еконт от офис Павликени и начини на плащане — наложен платеж или банков превод.' %}
{% set crumbs = [{ label: 'Поръчка и доставка' }] %}

{% block content %}
<div class="container pb-5 mb-lg-5">
  <header class="page-head">
    {% include "partials/_breadcrumbs.njk" %}
    <h1 class="display-2">Поръчка и доставка</h1>
    <p class="lead">Кратко и ясно — как се поръчва, как пристига и как се плаща.</p>
  </header>

  <div class="info-cards">
    <section class="info-card">
      <i class="bi bi-bag-check" aria-hidden="true"></i>
      <h2>Как да поръчате</h2>
      <ol>
        <li>Добавете продукта в количката и изпратете поръчката от <a href="/cart/index.html">страницата на количката</a>.</li>
        <li>Ще ви се обадим, за да уточним подробностите — не пропускайте телефона си.</li>
        <li>За въпроси преди поръчка: <a href="{{ site.contacts[0].phoneHref }}">{{ site.contacts[0].phone }}</a> или <a href="mailto:{{ site.contacts[0].email }}">{{ site.contacts[0].email }}</a>.</li>
      </ol>
    </section>
    <section class="info-card">
      <i class="bi bi-truck" aria-hidden="true"></i>
      <h2>Доставка</h2>
      <ul>
        <li>С Еконт, по условията и цените на Еконт за пратки от офис Павликени.</li>
        <li>Срокът след приета поръчка е според сроковете на Еконт — при наличност на изделието.</li>
        <li>Възможно е изделието да не е налично; тогава ще уточним срок за изработка.</li>
      </ul>
    </section>
    <section class="info-card">
      <i class="bi bi-wallet2" aria-hidden="true"></i>
      <h2>Плащане</h2>
      <ul>
        <li>Наложен платеж при получаване.</li>
        <li>Банков превод.</li>
        <li>Всички цени са в евро.</li>
      </ul>
    </section>
  </div>

  <div class="note-box mt-4">
    <i class="bi bi-info-circle" aria-hidden="true"></i>
    <p><strong>Изделия по задание и устройства за мониторинг.</strong> Не ги поддържаме на склад — изработваме ги след уточнение с вас. Ще потвърдим поръчката и срока по имейл; потвърждението служи като оферта и предварителен договор. Плащането е по банков път или с пощенски паричен превод по Еконт.</p>
  </div>
</div>
{% endblock %}
